# Smart Cloud Storage AI — Environment Configuration

# Server Settings
HOST=127.0.0.1
PORT=8000
DEBUG=True
ENVIRONMENT=development

# Database Settings (MongoDB Atlas or Local)
MONGODB_URI=mongodb://127.0.0.1:27017
DATABASE_NAME=smart_cloud_storage

# Authentication (JWT)
JWT_SECRET=super-secret-jwt-key-change-this-in-production-scs-ai-2026
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Storage Settings (local or s3)
STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=storage_vault
STORAGE_QUOTA_BYTES=107374182400

# AWS S3 Settings (Required only if STORAGE_BACKEND=s3)
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_REGION=us-east-1
S3_BUCKET_NAME=your-storage-bucket-name

# CORS Configuration
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000

# AI Models Settings
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
USE_DEVICE=cpu
